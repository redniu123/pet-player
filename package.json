{
  "name": "desktop-pet-player",
  "version": "0.5.0",
  "description": "通用 Windows 桌面宠物播放器，支持安全导入 .petpack 和生成客户专属便携版。",
  "main": "src/main-v3.js",
  "author": "redniu123 and contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run test:js && npm run test:python && npm run validate:demo",
    "test:js": "node --check src/main-v3.js && node --check src/preload-v3.js && node --check src/renderer-v3.js && node --check src/petpack-validator.js && node --check scripts/build-customer.js && node --check scripts/make-human-pet.js && node scripts/test-renderer-interaction.js && node scripts/test-petpack-security.js && node scripts/test-human-pet-framework.js",
    "test:python": "python -m unittest discover -s skills/desktop-pet-maker/scripts -p test_*.py -v",
    "test:regression": "node scripts/test-renderer-interaction.js && python skills/desktop-pet-maker/scripts/test_process_animation_strips.py -v",
    "validate:demo": "python skills/desktop-pet-maker/scripts/petpack_tool.py validate pets/packages/xiaogou.petpack",
    "start": "electron .",
    "pack": "electron-builder --dir --publish never",
    "build": "electron-builder --win portable --publish never",
    "build:customer": "node scripts/build-customer.js",
    "make:human": "node scripts/make-human-pet.js",
    "test:human-framework": "node scripts/test-human-pet-framework.js"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.desktop-pet.player",
    "productName": "桌宠播放器",
    "asar": true,
    "win": {
      "icon": "assets/generated/xiaogou.ico",
      "target": [
        "portable"
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Desktop-Pet-Player-${version}.${ext}"
    },
    "files": [
      "src/main-v3.js",
      "src/preload-v3.js",
      "src/index-v3.html",
      "src/styles-v3.css",
      "src/renderer-v3.js",
      "src/petpack-validator.js",
      "assets/generated/xiaogou-tray.png",
      "pets/packages/xiaogou.petpack",
      "package.json"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  }
}
